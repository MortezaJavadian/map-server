# ==============================================================================
# Map Server
# ==============================================================================

MAP_DOMAIN=maps.example.com

# ==============================================================================
# Docker Images
# ==============================================================================

TILESERVER_IMAGE=maptiler/tileserver-gl:v5.6.0-pre.4
TILEMAKER_IMAGE=ghcr.io/systemed/tilemaker:master

# Safer for large multi-country shards. Remove if you prefer maximum speed
# and have enough RAM.
TILEMAKER_EXTRA_ARGS=--shard-stores

# ==============================================================================
# Download Sources
# ==============================================================================

FONTS_BUNDLE_URL=https://github.com/korywka/fonts.pbf/archive/refs/heads/master.tar.gz
GEOFABRIK_INDEX_URL=https://download.geofabrik.de/index-v1-nogeom.json

COASTLINE_URL=https://osmdata.openstreetmap.de/download/water-polygons-split-4326.zip
NATURAL_EARTH_URBAN_URL=https://naciscdn.org/naturalearth/10m/cultural/ne_10m_urban_areas.zip
NATURAL_EARTH_ICE_SHELF_URL=https://naciscdn.org/naturalearth/10m/physical/ne_10m_antarctic_ice_shelves_polys.zip
NATURAL_EARTH_GLACIER_URL=https://naciscdn.org/naturalearth/10m/physical/ne_10m_glaciated_areas.zip
